# SmartDisk 应用清单
# fnOS 应用元数据：识别、展示、兼容性检查与运行环境准备。
# 字段说明见 https://developer.fnnas.com/docs/core-concepts/manifest/

# ---- 基础信息 ----
appname               = SmartDisk
version               = 1.3.0
display_name          = 磁盘高级管理
desc                  = 磁盘高级管理：扩展飞牛 fnOS 官方的基础磁盘显示，为 NAS 用户提供更专业、更完整的硬盘健康管理与冷备盘电源控制。<br><br><b>核心功能</b><br>· <b>全介质覆盖</b>：SATA 机械盘/固态盘、NVMe 固态盘、USB 桥接盘（含读卡器），自动识别接口与桥接芯片并选择正确透传协议<br>· <b>剩余写入寿命</b>：NVMe 直接读取百分比；SATA SSD 按主控厂商精准识别（群联/慧荣/Intel/三星等），三星盘按官方 TBW 数据估算，并标注精准/估算来源<br>· <b>SSD 主控识别</b>：群联 S11/S12、慧荣 SM22xx、三星、海力士、东芝/铠侠、闪迪、金士顿、建兴、威刚、浦科特、希捷等<br>· <b>深度健康数据</b>：通电时间与使用年限、容量使用、完整 SMART 属性（中文+厂商专属名+重要标记）、自检历史、ATA 错误日志、设备统计、SCT 温度历史、磁头加载计数<br>· <b>链路与存储</b>：SATA 协商速率与降速预警、SATA PHY 链路错误、NVMe PCIe 链路、分区/存储链（盘→分区→RAID→LVM→卷）、btrfs 存储池错误计数（数据静默损坏早期信号）、电源状态与 APM 级别<br>· <b>电源控制（仅机械硬盘）</b>：深度下线（卸载卷+内核级 device offline，飞牛后台与文件管理器都无法唤醒，冷备盘利器）、手动唤醒（重扫+补挂载）；<b>固态硬盘（SSD/NVMe）不能休眠</b>，仅 SATA 机械硬盘（HDD）可休眠；系统盘与 md 阵列成员盘有防误操作保护，读写中的盘需二次确认<br>· <b>中文健康评级</b>：综合重映射扇区、待处理扇区、CRC 错误、温度、寿命、btrfs 错误，给出 优/良/警/危 评级与可读风险提示<br><br>数据采集只读（smartctl / nvme / lsblk / btrfs）；仅电源控制会对磁盘做停转/上下线操作，且有严格确认与保护。

# ---- 平台与来源 ----
platform              = x86
source                = thirdparty

# ---- 开发者信息 ----
maintainer            = chanhuan
maintainer_url        = https://github.com/chanhuan
distributor           = chanhuan
distributor_url       = https://github.com/chanhuan

# ---- 兼容范围（按实测设置）----
os_min_version        = 1.0.0

# ---- 桌面集成 ----
desktop_uidir         = ui
desktop_applaunchname = SmartDisk.Application

# ---- 运行控制 ----
# 常驻服务，显示启动/停止/运行状态。
ctl_stop              = true

# ---- 授权 ----
# 本应用无需用户选择文件/目录访问权限，隐藏授权目录设置。
disable_authorization_path = true

# ---- 更新说明（面向用户，保持简洁）----
changelog             = v1.3.0 统一网关与移动端体验更新：移除不存在的独立端口声明，正式应用仅通过 fnOS 统一网关提供服务；新增管理员 Header 二次鉴权；增加手机 App CGI 启动兼容页，等待 WebView 登录态同步后自动进入；安装、升级和卸载前自动清理残留进程与 Socket，避免旧服务继续运行。
